<% layout("layouts/boilerplate.ejs") %>

    <style>
        body {

            background-image:
                linear-gradient(rgba(0, 0, 0, 0.6),
                    rgba(0, 0, 0, 0.9)),
                url('https://images.indianexpress.com/2026/03/heat.jpg?w=640');

            background-position: center;

            background-repeat: no-repeat;

            background-size: cover;

            min-height: 100vh;

        }


        h1 {

            font-size: clamp(3rem,
                    8vw,
                    100px);

            text-align: center;

            background:
                linear-gradient(to right,
                    #c09a13,
                    #ff0000);

            -webkit-background-clip: text;

            background-clip: text;

            -webkit-text-fill-color: transparent;

            color: transparent;

            overflow: hidden;

            border-right: .05em solid orange;

            white-space: nowrap;

            margin: 0 auto;

            letter-spacing: .15em;

            animation:
                typing 2.5s steps(14, end),
                blink-caret .75s step-end infinite;

        }


        h2 {

            text-align: center;

            font-size: clamp(1.2rem,
                    3vw,
                    2rem);

        }


        nav {

            background: transparent;

        }


        .nav-link {

            color: white;

        }


        footer {

            visibility: hidden;

        }


        .scaleUp {

            animation:
                scaleUp 1s linear forwards;

        }


        .fadeInUp {

            animation:
                fadeInUp 1.5s ease-out both;

        }


        .fadeInUp:nth-child(1) {

            animation-delay: 1s;

        }


        .fadeInUp:nth-child(2) {

            animation-delay: 1.5s;

        }


        .fadeInUp:nth-child(3) {

            animation-delay: 2s;

        }


        .fadeInUp:nth-child(4) {

            animation-delay: 2.5s;

        }


        @keyframes scaleUp {

            from {

                opacity: 0;

                transform: scale(0);

            }

            to {

                opacity: 1;

                transform: scale(1);

            }

        }


        @keyframes fadeInUp {

            from {

                opacity: 0;

                transform: translateY(100px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }


        @keyframes typing {

            from {

                width: 0;

            }

            to {

                width: 100%;

            }

        }


        @keyframes blink-caret {

            from,
            to {

                border-color: transparent;

            }

            50% {

                border-color: orange;

            }

        }


        /* ==========================================
       TABLET
    ========================================== */

        @media (max-width: 991px) {

            h1 {

                letter-spacing: .1em;

            }


            .container-fluid.py-5 {

                padding-top: 4rem !important;

                padding-bottom: 3rem !important;

            }


            .container.mt-5 {

                margin-top: 3rem !important;

            }


            .container.mt-5 p {

                font-size: 1.05rem !important;

                line-height: 1.7;

            }

        }


        /* ==========================================
       MOBILE
    ========================================== */

        @media (max-width: 767px) {

            h1 {

                font-size: clamp(2.5rem,
                        12vw,
                        50px);

                letter-spacing: .06em;

            }


            h2 {

                font-size: 1.25rem;

                line-height: 1.5;

                padding: 0 10px;

            }


            .container-fluid.py-5 {

                padding-top: 3rem !important;

            }


            .container.mt-5 {

                margin-top: 2.5rem !important;

            }


            .container.mt-5 p {

                font-size: 1rem !important;

                line-height: 1.7;

                padding: 0 5px;

            }

        }


        /* ==========================================
       SMALL MOBILE
    ========================================== */

        @media (max-width: 575px) {

            h1 {

                font-size: clamp(2rem,
                        11vw,
                        42px);

                letter-spacing: .04em;

            }


            h2 {

                font-size: 1.05rem;

            }


            .container-fluid.py-5 {

                padding-top: 2rem !important;

            }


            .container.mt-5 {

                margin-top: 2rem !important;

            }


            .container.mt-5 p {

                font-size: 0.95rem !important;

                line-height: 1.65;

            }

        }
    </style>


    <div class="container-fluid py-5">

        <h1 class="fw-bolder typing blink-caret">

            TaapSurakshak

        </h1>


        <h2 class="text-light fadeInUp">

            "Predict Heat, Protect Lives"

        </h2>


        <!-- Description -->

        <div class="container mt-5">

            <p class="text-center text-white fs-5 fadeInUp">

                <strong>TaapSurakshak</strong> is a smart heat-risk monitoring
                and response platform designed to help cities prevent
                heat-related illness and deaths.

                It combines temperature and mortality-risk analysis with
                hospital-capacity monitoring, predictive alerts, regional
                heatmaps, and emergency broadcast tools.

                By identifying high-risk areas and forecasting critical
                conditions, the platform helps authorities and healthcare
                teams respond early, allocate resources efficiently, and
                protect vulnerable communities.

            </p>

        </div>

    </div>