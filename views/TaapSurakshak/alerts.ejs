<% layout("layouts/boilerplate.ejs") %>

  <style>
    .alerts-page {
      color: #071b3a;
    }

    .page-header {
      border-bottom: 1px solid #eadede;
      padding-bottom: 16px;
      margin-bottom: 22px;
    }

    .page-header h1 {
      font-size: 1.55rem;
      font-weight: 700;
    }

    .page-header p {
      color: #704040;
      font-size: 0.85rem;
    }

    .section-card {
      background: #ffffff;
      border: 1px solid #efdada;
      border-radius: 0;
    }

    .section-card .card-body {
      padding: 20px;
    }

    .section-title {
      border-bottom: 1px solid #eadede;
      padding-bottom: 12px;
      margin-bottom: 18px;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .section-title .icon {
      color: #bd001b;
      margin-right: 8px;
    }

    .form-label {
      color: #542020;
      font-size: 0.72rem;
      font-weight: 600;
      margin-bottom: 7px;
    }

    .form-control,
    .form-select {
      border: 1px solid #efcccc;
      border-radius: 0;
      color: #18345d;
      font-size: 0.8rem;
      min-height: 42px;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #bd001b;
      box-shadow: 0 0 0 0.15rem rgba(189, 0, 27, 0.1);
    }

    .preview-btn {
      background: #bd001b;
      border: none;
      border-radius: 2px;
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 13px;
      width: 100%;
    }

    .preview-btn:hover {
      background: #990016;
      color: white;
    }

    .message-preview {
      background: #fffafa;
      border: 1px solid #f1a2a2;
      border-left: 4px solid #bd001b;
      padding: 15px;
      margin-top: 18px;
    }

    .message-preview-title {
      color: #bd001b;
      font-size: 0.72rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .message-preview-text {
      color: #18345d;
      font-size: 0.8rem;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .status-message {
      font-size: 0.78rem;
      margin-top: 12px;
    }

    .info-box {
      background: #f4f6ff;
      border: 1px solid #dce5ff;
      color: #3159a2;
      font-size: 0.75rem;
      line-height: 1.6;
      padding: 14px;
    }
  </style>

  <div class="container-fluid alerts-page">

    <div class="page-header">
      <h1>Personalized Heat-Safety Messaging</h1>

      <p class="mb-0">
        Generate an age-specific heat-health message and send it by SMS.
      </p>
    </div>

    <div class="row g-4">

      <!-- Form -->
      <div class="col-12 col-lg-6">

        <div class="card section-card">
          <div class="card-body">

            <h4 class="section-title">
              <span class="icon">◎</span>
              User Information
            </h4>

            <form id="personalizedSmsForm">

              <div class="mb-3">
                <label for="userName" class="form-label">
                  User Name
                </label>

                <input type="text" id="userName" class="form-control" placeholder="Enter user name" required>
              </div>

              <div class="mb-3">
                <label for="age" class="form-label">
                  Age
                </label>

                <input type="number" id="age" class="form-control" min="1" max="120" placeholder="Enter age" required>
              </div>

              <div class="mb-3">
                <label for="phoneNumber" class="form-label">
                  Phone Number
                </label>

                <input type="text" id="phoneNumber" class="form-control" placeholder="Enter phone number" required>
              </div>

              <div class="row">
                <div class="form-group">
                  <label class="form-label" for="heatStress">Heat Stress / WBGT</label>
                  <input type="text" class="form-control"   id="heatStress" name="heatStress" readonly placeholder="Loading..." />
                </div>

                <div class="form-group">
                  <label class="form-label" for="mortalityRisk">Mortality Risk / HMRI</label>
                  <input type="text" class="form-control"   id="mortalityRisk" name="mortalityRisk" readonly placeholder="Loading..." />
                </div>

                <div class="form-group">
                  <label class="form-label" for="riskLevel">Overall Risk Level</label>
                  <input type="text" class="form-control"   id="riskLevel" name="riskLevel" readonly placeholder="Loading..." />
                </div>

                <input type="hidden" id="heatRisk" />
                <input type="hidden" id="mortalityIndex" />

              </div>

              <button type="submit" class="btn preview-btn" id="sendSmsButton">
                GENERATE AND SEND SMS
              </button>

              <div id="smsStatus" class="status-message"></div>

            </form>

          </div>
        </div>

      </div>

      <!-- Preview -->
      <div class="col-12 col-lg-6">

        <div class="card section-card">
          <div class="card-body">

            <h4 class="section-title">
              <span class="icon">◉</span>
              Personalized Message Preview
            </h4>

            <div class="info-box mb-3">
              The message will be generated using the user’s age,
              heat risk, and mortality index.
            </div>

            <div id="smsPreview">
              <p class="text-muted">
                Your personalized message will appear here.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", async function () {
      const form = document.getElementById("personalizedSmsForm");
      const statusElement = document.getElementById("smsStatus");
      const previewElement = document.getElementById("smsPreview");
      const sendButton = document.getElementById("sendSmsButton");

      const heatStressInput = document.getElementById("heatStress");
      const mortalityRiskInput = document.getElementById("mortalityRisk");
      const riskLevelInput = document.getElementById("riskLevel");

      const heatRiskHiddenInput = document.getElementById("heatRisk");
      const mortalityIndexHiddenInput =
        document.getElementById("mortalityIndex");

      let backendHeatData = null;

      /*
       * Load heat-health prediction from FastAPI through Express.
       *
       * Expected backend response:
       *
       * {
       *   "3d": {
       *     "wbgt_c": 25.5128,
       *     "hmri": 14.18,
       *     "risk_level": "Low"
       *   },
       *   "4d": {
       *     "wbgt_c": 25.5950,
       *     "hmri": 14.95,
       *     "risk_level": "Low"
       *   },
       *   "5d": {
       *     "wbgt_c": 25.5127,
       *     "hmri": 14.18,
       *     "risk_level": "Low"
       *   }
       * }
       */

      async function loadHeatData() {
        try {
          statusElement.innerHTML =
            '<span class="text-primary">Loading heat-health data...</span>';

          const response = await fetch("/api/latest-heat-data");

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(
              result.message ||
              "Unable to load heat-health data."
            );
          }

          /*
           * Express has already converted the FastAPI response:
           *
           * heatStress    = wbgt_c
           * mortalityRisk = hmri
           * riskLevel     = risk_level
           */

          backendHeatData = {
            heatStress: Number(result.heatStress),
            mortalityRisk: Number(result.mortalityRisk),
            riskLevel: result.riskLevel
          };

          if (
            Number.isNaN(backendHeatData.heatStress) ||
            Number.isNaN(backendHeatData.mortalityRisk)
          ) {
            throw new Error(
              "Invalid heat-health values received from backend."
            );
          }

          heatStressInput.value =
            backendHeatData.heatStress.toFixed(2);

          mortalityRiskInput.value =
            backendHeatData.mortalityRisk.toFixed(2);

          riskLevelInput.value =
            backendHeatData.riskLevel || "Unknown";

          heatRiskHiddenInput.value =
            backendHeatData.heatStress;

          mortalityIndexHiddenInput.value =
            backendHeatData.mortalityRisk;

          statusElement.innerHTML =
            '<span class="text-success">Heat-health data loaded successfully.</span>';

        } catch (error) {
          console.error("Heat-health data error:", error);

          backendHeatData = null;

          heatStressInput.value = "Unavailable";
          mortalityRiskInput.value = "Unavailable";
          riskLevelInput.value = "Unavailable";

          heatRiskHiddenInput.value = "";
          mortalityIndexHiddenInput.value = "";

          statusElement.innerHTML =
            `<span class="text-danger">${escapeHtml(error.message)}</span>`;
        }
      }

      /*
       * Submit personalized SMS form.
       */
      form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const name = document.getElementById("userName").value.trim();

        const age = Number(
          document.getElementById("age").value
        );

        const phoneNumber =
          document.getElementById("phoneNumber").value.trim();

        /*
         * Do not allow submission before backend data is loaded.
         */
        if (!backendHeatData) {
          statusElement.innerHTML =
            '<span class="text-danger">Please wait until heat-health data is loaded.</span>';

          return;
        }

        /*
         * Read heat and mortality values from backend data.
         */
        const heatRisk = Number(
          backendHeatData.heatStress
        );

        const mortalityIndex = Number(
          backendHeatData.mortalityRisk
        );

        if (
          !name ||
          !age ||
          !phoneNumber ||
          Number.isNaN(heatRisk) ||
          Number.isNaN(mortalityIndex)
        ) {
          statusElement.innerHTML =
            '<span class="text-danger">Please fill in all required fields.</span>';

          return;
        }

        sendButton.disabled = true;
        sendButton.textContent = "GENERATING...";

        statusElement.innerHTML =
          '<span class="text-primary">Generating and sending message...</span>';

        previewElement.innerHTML = "";

        try {
          const response = await fetch(
            "/api/generate-personalized-sms",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                name: name,
                age: age,
                phoneNumber: phoneNumber,

                /*
                 * These values come from FastAPI prediction.
                 */
                heat_risk: heatRisk,
                mortality_index: mortalityIndex
              })
            }
          );

          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(
              data.message || "Unable to generate or send SMS."
            );
          }

          statusElement.innerHTML =
            '<span class="text-success">SMS sent successfully.</span>';

          previewElement.innerHTML = `
          <div class="message-preview">
            <div class="message-preview-title">
              SENT MESSAGE
            </div>

            <p class="message-preview-text">
              ${escapeHtml(
            data.feedback ||
            data.message ||
            "Personalized message generated successfully."
          )}
            </p>
          </div>

          <div class="mt-3 small">
            <strong>Risk Level:</strong>
            ${escapeHtml(
            data.risk_level ||
            backendHeatData.riskLevel ||
            "Unknown"
          )}
            <br>

            <strong>Heat Stress / WBGT:</strong>
            ${escapeHtml(heatRisk.toFixed(2))}
            <br>

            <strong>Mortality Risk / HMRI:</strong>
            ${escapeHtml(mortalityIndex.toFixed(2))}
            <br>

            <strong>Priority:</strong>
            ${escapeHtml(data.priority ?? "N/A")}
          </div>
        `;

        } catch (error) {
          console.error("Personalized SMS error:", error);

          statusElement.innerHTML =
            `<span class="text-danger">${escapeHtml(error.message)}</span>`;

        } finally {
          sendButton.disabled = false;
          sendButton.textContent = "GENERATE AND SEND SMS";
        }
      });

      /*
       * Escape text before inserting it into HTML.
       */
      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      /*
       * Load backend prediction when the page opens.
       */
      await loadHeatData();
    });
  </script>