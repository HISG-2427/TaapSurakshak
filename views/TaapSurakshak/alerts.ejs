<% layout("layouts/boilerplate.ejs") %>

  <style>
    .alerts-page {
      color: #071b3a;
      width: 100%;
    }

    .page-header {
      border-bottom: 1px solid #eadede;
      padding-bottom: 16px;
      margin-bottom: 22px;
    }

    .page-header h1 {
      font-size: 1.55rem;
      font-weight: 700;
    }

    .page-header p {
      color: #704040;
      font-size: 0.85rem;
    }

    .section-card {
      background: #ffffff;
      border: 1px solid #efdada;
      border-radius: 0;
    }

    .section-card .card-body {
      padding: 20px;
    }

    .section-title {
      border-bottom: 1px solid #eadede;
      padding-bottom: 12px;
      margin-bottom: 18px;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .section-title .icon {
      color: #bd001b;
      margin-right: 8px;
    }

    .form-label {
      color: #542020;
      font-size: 0.72rem;
      font-weight: 600;
      margin-bottom: 9px;
      display: block;
    }

    .form-control,
    .form-select {
      border: 1px solid #efcccc;
      border-radius: 0;
      color: #18345d;
      font-size: 0.8rem;
      min-height: 42px;
      width: 100%;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #bd001b;
      box-shadow: 0 0 0 0.15rem rgba(189, 0, 27, 0.1);
    }

    .preview-btn {
      background: #bd001b;
      border: none;
      border-radius: 2px;
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 13px;
      width: 100%;
    }

    .preview-btn:hover {
      background: #990016;
      color: white;
    }

    .message-preview {
      background: #fffafa;
      border: 1px solid #f1a2a2;
      border-left: 4px solid #bd001b;
      padding: 15px;
      margin-top: 18px;
    }

    .message-preview-title {
      color: #bd001b;
      font-size: 0.72rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .message-preview-text {
      color: #18345d;
      font-size: 0.8rem;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .status-message {
      font-size: 0.78rem;
      margin-top: 12px;
    }

    .info-box {
      background: #f4f6ff;
      border: 1px solid #dce5ff;
      color: #3159a2;
      font-size: 0.75rem;
      line-height: 1.6;
      padding: 14px;
    }

    .metric-box {
      background: #fffafa;
      border: 1px solid #efdada;
      padding: 14px;
    }

    .metric-label {
      color: #704040;
      font-size: 0.7rem;
      font-weight: 600;
      margin-bottom: 9px;
      display: block;
    }


    /* ==========================================
     WHATSAPP QR SECTION
  ========================================== */

    .whatsapp-section {
      margin-top: 24px;
    }

    .whatsapp-status-card {
      background: #fffafa;
      border: 1px solid #efdada;
      padding: 20px;
      text-align: center;
    }

    .whatsapp-status-title {
      color: #071b3a;
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .whatsapp-status-text {
      color: #704040;
      font-size: 0.75rem;
      line-height: 1.6;
      margin-bottom: 15px;
    }

    #whatsappQRCode {
      background: #ffffff;
      border: 1px solid #eadede;
      padding: 15px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 250px;
      min-height: 250px;
    }

    #whatsappQRCode img {
      width: 220px;
      height: 220px;
      display: block;
    }

    .whatsapp-ready {
      color: #198754;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .whatsapp-waiting {
      color: #3159a2;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .whatsapp-disabled {
      color: #bd001b;
      font-size: 0.8rem;
      font-weight: 600;
    }


    /* ==========================================
     ALERTS FORM RESPONSIVENESS
  ========================================== */

    #personalizedSmsForm {
      width: 100%;
    }

    #personalizedSmsForm .form-control,
    #personalizedSmsForm .form-select {
      width: 100%;
    }

    #personalizedSmsForm .mb-3 {
      margin-bottom: 1.25rem !important;
    }


    /* ==========================================
     TABLET
  ========================================== */

    @media (max-width: 991px) {

      .alerts-page {
        padding-left: 15px;
        padding-right: 15px;
      }

      .section-card {
        width: 100%;
      }

      .section-card .card-body {
        padding: 1.5rem;
      }

      #personalizedSmsForm {
        width: 100%;
      }

      #personalizedSmsForm .form-label {
        margin-bottom: 10px;
      }

      #personalizedSmsForm .metric-label {
        margin-bottom: 10px;
      }

    }


    /* ==========================================
     MOBILE
  ========================================== */

    @media (max-width: 767px) {

      .alerts-page {
        padding-left: 10px;
        padding-right: 10px;
      }

      .section-card {
        width: 100%;
        margin-left: 0;
        margin-right: 0;
      }

      .section-card .card-body {
        padding: 1.25rem !important;
      }

      #personalizedSmsForm {
        width: 100%;
      }

      #personalizedSmsForm .mb-3 {
        width: 100%;
        margin-bottom: 1.35rem !important;
      }

      #personalizedSmsForm .form-control,
      #personalizedSmsForm .form-select {
        width: 100%;
        min-height: 46px;
        font-size: 1rem;
      }

      #personalizedSmsForm .form-label {
        font-size: 0.95rem;
        margin-bottom: 10px;
      }

      #personalizedSmsForm .metric-label {
        font-size: 0.85rem;
        margin-bottom: 10px;
      }

      .metric-box {
        padding: 14px;
      }

      #whatsappQRCode {
        min-width: 230px;
        min-height: 230px;
      }

      #whatsappQRCode img {
        width: 200px;
        height: 200px;
      }

    }


    /* ==========================================
     SMALL MOBILE
  ========================================== */

    @media (max-width: 575px) {

      .alerts-page {
        padding-left: 8px;
        padding-right: 8px;
      }

      .section-card .card-body {
        padding: 1rem !important;
      }

      .section-title {
        font-size: 1.15rem;
        margin-bottom: 20px;
      }

      #personalizedSmsForm .mb-3 {
        margin-bottom: 1.4rem !important;
      }

      #personalizedSmsForm .form-control,
      #personalizedSmsForm .form-select {
        min-height: 48px;
        font-size: 1rem;
      }

      #personalizedSmsForm .form-label {
        font-size: 0.9rem;
        margin-bottom: 11px;
      }

      #personalizedSmsForm .metric-label {
        font-size: 0.85rem;
        margin-bottom: 11px;
      }

      .whatsapp-status-card {
        padding: 15px;
      }

      #whatsappQRCode {
        min-width: 210px;
        min-height: 210px;
        padding: 10px;
      }

      #whatsappQRCode img {
        width: 180px;
        height: 180px;
      }

    }
  </style>


  <div class="container-fluid alerts-page">


    <div class="page-header">

      <h1>
        Personalized Heat-Safety Messaging
      </h1>

      <p class="mb-0">
        Generate AI personalized heat-health advisories and dispatch them instantly via WhatsApp and SMS.
      </p>

    </div>


    <div class="row g-4">


      <!-- ============================= -->
      <!-- LEFT SIDE - FORM -->
      <!-- ============================= -->

      <div class="col-12 col-lg-6">

        <div class="card section-card">

          <div class="card-body">

            <h4 class="section-title">

              <span class="icon">◎</span>

              Recipient Information

            </h4>


            <form id="personalizedSmsForm">


              <!-- USER NAME -->

              <div class="mb-3">

                <label for="userName" class="form-label">
                  User Name
                </label>

                <input type="text" id="userName" class="form-control" placeholder="Enter user name" required>

              </div>


              <!-- AGE -->

              <div class="mb-3">

                <label for="age" class="form-label">
                  Age
                </label>

                <input type="number" id="age" class="form-control" min="1" max="120" value="30" placeholder="Enter age"
                  required>

              </div>


              <!-- PHONE -->

              <div class="mb-3">

                <label for="phoneNumber" class="form-label">
                  WhatsApp / Phone Number
                </label>

                <input type="text" id="phoneNumber" class="form-control" value="+91 " placeholder="Phone number"
                  required>

              </div>


              <!-- ============================= -->
              <!-- RISK + TEMPERATURE -->
              <!-- ============================= -->

              <div class="row g-3 mb-3">


                <!-- OVERALL RISK -->

                <div class="col-12 col-md-6">

                  <div class="metric-box">

                    <label for="riskLevel" class="metric-label">
                      Overall Risk Level
                    </label>

                    <input type="text" id="riskLevel" name="riskLevel" class="form-control" readonly
                      placeholder="Loading...">

                  </div>

                </div>


                <!-- TEMPERATURE -->

                <div class="col-12 col-md-6">

                  <div class="metric-box">

                    <label for="temperature" class="metric-label">
                      Temperature
                    </label>

                    <input type="text" id="temperature" name="temperature" class="form-control" readonly
                      placeholder="Loading...">

                  </div>

                </div>

              </div>


              <!-- ============================= -->
              <!-- SEND BUTTON -->
              <!-- ============================= -->

              <button type="submit" class="btn preview-btn" id="sendSmsButton">
                GENERATE & SEND WHATSAPP ALERT
              </button>


              <!-- STATUS -->

              <div id="smsStatus" class="status-message"></div>


            </form>

          </div>

        </div>

      </div>



      <!-- ============================= -->
      <!-- RIGHT SIDE -->
      <!-- ============================= -->

      <div class="col-12 col-lg-6">


        <!-- ============================= -->
        <!-- MESSAGE PREVIEW -->
        <!-- ============================= -->

        <div class="card section-card">

          <div class="card-body">

            <h4 class="section-title">

              <span class="icon">◉</span>

              Personalized Message Preview

            </h4>


            <div class="info-box mb-3">

              The message will be dynamically generated
              using the recipient's age, overall heat-health
              risk and current Mumbai temperature.

            </div>


            <div id="smsPreview">

              <p class="text-muted">
                Your personalized alert preview will appear here once generated.
              </p>

            </div>

          </div>

        </div>



        <!-- ============================= -->
        <!-- WHATSAPP LINKING -->
        <!-- ============================= -->

        <div class="whatsapp-section">

          <div class="card section-card">

            <div class="card-body">

              <h4 class="section-title">

                <span class="icon">◉</span>

                WhatsApp Linking

              </h4>


              <div class="whatsapp-status-card">


                <div class="whatsapp-status-title">

                  Link WhatsApp to TaapSurakshak

                </div>


                <div id="whatsappStatusText" class="whatsapp-status-text">

                  Checking WhatsApp connection...

                </div>


                <div id="whatsappQRCode">

                  <span class="whatsapp-waiting">
                    Waiting for WhatsApp QR...
                  </span>

                </div>


                <div class="whatsapp-status-text" style="margin-top:15px;">

                  Open WhatsApp on your phone →
                  Linked Devices →
                  Link a Device →
                  Scan this QR code.

                </div>


              </div>

            </div>

          </div>

        </div>


      </div>

    </div>

  </div>



  <script>

    document.addEventListener(
      "DOMContentLoaded",
      async function () {


        /* ==========================================
           GET HTML ELEMENTS
        ========================================== */

        const form =
          document.getElementById(
            "personalizedSmsForm"
          );


        const statusElement =
          document.getElementById(
            "smsStatus"
          );


        const previewElement =
          document.getElementById(
            "smsPreview"
          );


        const sendButton =
          document.getElementById(
            "sendSmsButton"
          );


        const riskLevelInput =
          document.getElementById(
            "riskLevel"
          );


        const temperatureInput =
          document.getElementById(
            "temperature"
          );


        const whatsappQRCode =
          document.getElementById(
            "whatsappQRCode"
          );


        const whatsappStatusText =
          document.getElementById(
            "whatsappStatusText"
          );


        /* ==========================================
           VARIABLES
        ========================================== */

        let overallRisk = null;

        let currentTemperature = null;


        /* ==========================================
           ESCAPE HTML
        ========================================== */

        function escapeHtml(value) {

          if (
            value === null ||
            value === undefined
          ) {

            return "";

          }


          return String(value)

            .replaceAll(
              "&",
              "&amp;"
            )

            .replaceAll(
              "<",
              "&lt;"
            )

            .replaceAll(
              ">",
              "&gt;"
            )

            .replaceAll(
              '"',
              "&quot;"
            )

            .replaceAll(
              "'",
              "&#039;"
            );

        }


        /* ==========================================
           LOAD WHATSAPP QR
        ========================================== */

        async function loadWhatsAppStatus() {

          try {

            const response =
              await fetch(
                "/api/whatsapp-status"
              );


            const result =
              await response.json();


            if (
              !response.ok ||
              !result.success
            ) {

              throw new Error(
                result.message ||
                "Unable to check WhatsApp status."
              );

            }


            /* ======================================
               WHATSAPP DISABLED
            ====================================== */

            if (!result.enabled) {

              whatsappStatusText.innerHTML =
                '<span class="whatsapp-disabled">' +
                '⚠️ WhatsApp linking is currently disabled.' +
                '</span>';


              whatsappQRCode.innerHTML = `

              <div class="whatsapp-disabled">

                Enable WhatsApp on the server
                to generate the linking QR.

              </div>

            `;

              return;

            }


            /* ======================================
               WHATSAPP ALREADY CONNECTED
            ====================================== */

            if (result.ready) {

              whatsappStatusText.innerHTML =
                '<span class="whatsapp-ready">' +
                '✅ WhatsApp is connected and ready.' +
                '</span>';


              whatsappQRCode.innerHTML = `

              <div class="whatsapp-ready">

                ✅ WhatsApp Linked

                <br>

                You can now send
                personalized WhatsApp alerts.

              </div>

            `;

              return;

            }


            /* ======================================
               QR AVAILABLE
            ====================================== */

            if (result.qr) {

              whatsappStatusText.innerHTML =
                '<span class="whatsapp-waiting">' +
                '📱 Scan the QR code with WhatsApp.' +
                '</span>';


              whatsappQRCode.innerHTML = `

              <img
                src="${result.qr}"
                alt="WhatsApp linking QR code"
              >

            `;

              return;

            }


            /* ======================================
               WAITING FOR QR
            ====================================== */

            whatsappStatusText.innerHTML =
              '<span class="whatsapp-waiting">' +
              '⏳ Waiting for WhatsApp to generate QR...' +
              '</span>';


            whatsappQRCode.innerHTML = `

            <span class="whatsapp-waiting">

              Waiting for QR code...

            </span>

          `;


          } catch (error) {

            console.error(
              "WhatsApp status error:",
              error
            );


            whatsappStatusText.innerHTML =
              '<span class="whatsapp-disabled">' +
              '❌ Unable to connect to WhatsApp service.' +
              '</span>';


            whatsappQRCode.innerHTML = `

            <span class="whatsapp-disabled">

              WhatsApp status unavailable.

            </span>

          `;

          }

        }


        /* ==========================================
           KEEP QR STATUS UPDATED
        ========================================== */

        await loadWhatsAppStatus();


        setInterval(
          loadWhatsAppStatus,
          3000
        );


        /* ==========================================
           LOAD OVERALL RISK LEVEL
           
           FROM EXPRESS BACKEND
           
           GET /api/latest-heat-data
        ========================================== */

        async function loadRiskLevel() {

          try {

            riskLevelInput.value =
              "Loading...";


            const response =
              await fetch(
                "/api/latest-heat-data"
              );


            const result =
              await response.json();


            if (
              !response.ok ||
              !result.success
            ) {

              throw new Error(
                result.message ||
                "Unable to load overall risk."
              );

            }


            overallRisk =
              result.riskLevel ||
              result.overallRisk ||
              result.risk_level;


            if (!overallRisk) {

              throw new Error(
                "Overall risk level was not returned by backend."
              );

            }


            riskLevelInput.value =
              overallRisk;


            return true;

          } catch (error) {

            console.error(
              "Risk level error:",
              error
            );


            overallRisk = null;


            riskLevelInput.value =
              "Unavailable";


            return false;

          }

        }


        /* ==========================================
           LOAD TEMPERATURE
        ========================================== */

        async function loadTemperature() {

          try {

            temperatureInput.value =
              "Loading...";


            const apiKey =
              "4a3859186dbabdd652e466a270aab3ec";


            const city =
              "Mumbai";


            const url =
              "https://api.openweathermap.org/data/2.5/weather" +
              `?q=${city}` +
              "&units=metric" +
              `&appid=${apiKey}`;


            const response =
              await fetch(url);


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.message ||
                "Unable to load temperature."
              );

            }


            currentTemperature =
              Number(
                data.main.temp
              );


            if (
              Number.isNaN(
                currentTemperature
              )
            ) {

              throw new Error(
                "Invalid temperature received."
              );

            }


            temperatureInput.value =
              `${currentTemperature.toFixed(1)} °C`;


            return true;

          } catch (error) {

            console.error(
              "Temperature error:",
              error
            );


            currentTemperature = null;


            temperatureInput.value =
              "Unavailable";


            return false;

          }

        }


        /* ==========================================
           LOAD BOTH DATA
        ========================================== */

        async function loadLiveData() {

          statusElement.innerHTML =
            '<span class="text-primary">' +
            'Loading live risk and temperature...' +
            '</span>';


          const [
            riskLoaded,
            temperatureLoaded
          ] = await Promise.all([

            loadRiskLevel(),

            loadTemperature()

          ]);


          if (
            riskLoaded &&
            temperatureLoaded
          ) {

            statusElement.innerHTML =
              '<span class="text-success">' +
              '✅ Risk level and temperature loaded.' +
              '</span>';

          }


          else if (riskLoaded) {

            statusElement.innerHTML =
              '<span class="text-warning">' +
              '⚠️ Risk loaded, but temperature unavailable.' +
              '</span>';

          }


          else if (temperatureLoaded) {

            statusElement.innerHTML =
              '<span class="text-warning">' +
              '⚠️ Temperature loaded, but risk unavailable.' +
              '</span>';

          }


          else {

            statusElement.innerHTML =
              '<span class="text-danger">' +
              '❌ Unable to load live data.' +
              '</span>';

          }

        }


        /* ==========================================
           FORM SUBMIT
        ========================================== */

        form.addEventListener(
          "submit",
          async function (event) {

            event.preventDefault();


            const name =
              document
                .getElementById("userName")
                .value
                .trim();


            const age =
              Number(
                document
                  .getElementById("age")
                  .value
              );


            const phoneNumber =
              document
                .getElementById("phoneNumber")
                .value
                .trim();


            if (
              !name ||
              !age ||
              !phoneNumber
            ) {

              statusElement.innerHTML =
                '<span class="text-danger">' +
                'Please fill in all required fields.' +
                '</span>';


              return;

            }


            if (!overallRisk) {

              statusElement.innerHTML =
                '<span class="text-danger">' +
                'Overall risk level is not available.' +
                '</span>';


              return;

            }


            if (
              currentTemperature === null
            ) {

              statusElement.innerHTML =
                '<span class="text-danger">' +
                'Temperature is not available.' +
                '</span>';


              return;

            }


            sendButton.disabled =
              true;


            sendButton.textContent =
              "GENERATING & SENDING...";


            statusElement.innerHTML =
              '<span class="text-primary">' +
              'Generating AI message & dispatching WhatsApp alert...' +
              '</span>';


            previewElement.innerHTML =
              "";


            try {

              const requestBody = {

                name: name,

                age: age,

                phoneNumber: phoneNumber,

                overall_risk:
                  overallRisk,

                temperature:
                  currentTemperature

              };


              const response = await fetch("/api/generate-personalized-whatsapp", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                  phoneNumber,
                  name,
                  temperature
                })
              });

              const data = await response.json();


              if (
                !response.ok ||
                !data.success
              ) {

                throw new Error(
                  data.message ||
                  "Unable to generate or send advisory."
                );

              }


              statusElement.innerHTML =
                '<span class="text-success">' +
                '✅ Alert dispatched successfully!' +
                '</span>';


              previewElement.innerHTML = `

              <div class="message-preview">

                <div class="message-preview-title">
                  DISPATCHED MESSAGE
                </div>

                <p
                  class="message-preview-text"
                  style="white-space: pre-wrap;"
                >
                  ${escapeHtml(
                data.feedback ||
                data.message ||
                "Message generated successfully."
              )}
                </p>

              </div>


              <div class="mt-3 small border p-2 bg-light">

                <strong>
                  WhatsApp Delivery Status:
                </strong>

                ${escapeHtml(
                data.whatsappStatus ||
                "Sent"
              )}

                <br>

                <strong>
                  Overall Risk Level:
                </strong>

                ${escapeHtml(
                overallRisk
              )}

                <br>

                <strong>
                  Temperature:
                </strong>

                ${escapeHtml(
                currentTemperature.toFixed(1)
              )} °C

              </div>

            `;


            } catch (error) {

              console.error(
                "Personalized alert error:",
                error
              );


              statusElement.innerHTML =
                `<span class="text-danger">
                ${escapeHtml(
                  error.message
                )}
              </span>`;

            } finally {

              sendButton.disabled =
                false;


              sendButton.textContent =
                "GENERATE & SEND WHATSAPP ALERT";

            }

          }
        );


        /* ==========================================
           START LIVE DATA
        ========================================== */

        await loadLiveData();

      }
    );

  </script>