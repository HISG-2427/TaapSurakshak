<% layout("layouts/boilerplate") %>

<style>

    nav,
    footer {
        visibility: hidden;
    }


    body {
        background-image: url("/images/LoginBG_Final.jpeg");

        background-size: cover;

        background-position: center;

        min-height: 100vh;
    }


    select.form-select {
        background-color: transparent !important;

        color: white;

        border: 2px solid white;
    }


    select.form-select option {
        background-color: #222;

        color: white;
    }


    input[type="text"],
    input[type="password"],
    input[type="number"],
    input[type="tel"] {

        background: transparent;

        color: white;

        border: 2px solid white;

        width: 100%;
    }


    input[type="text"]::placeholder,
    input[type="password"]::placeholder,
    input[type="number"]::placeholder,
    input[type="tel"]::placeholder {

        color: rgb(210, 205, 205);
    }


    label {
        color: white;
    }


    input[type="text"]:focus,
    input[type="password"]:focus,
    input[type="number"]:focus,
    input[type="tel"]:focus {

        background: transparent;

        color: white;

        border: 3px solid white;
    }


    /* ==========================================
       FORM CONTAINER
    ========================================== */

    .login-form-container {
        width: 50%;
        margin-left: auto;
        margin-right: auto;
    }


    /* ==========================================
       TABLET
    ========================================== */

    @media (max-width: 991px) {

        .login-form-container {

            width: 70%;

        }

    }


    /* ==========================================
       MOBILE
    ========================================== */

    @media (max-width: 767px) {

        .login-form-container {

            width: 90%;

        }


        .login-form-container .row {

            margin-left: 0;
            margin-right: 0;
        }


        .login-form-container
        .col-md-6,
        .login-form-container
        .col-md-9 {

            width: 100%;
        }


        .login-form-container
        .btn {

            margin: 0.5rem 0 !important;
        }

    }


    /* ==========================================
       SMALL MOBILE
    ========================================== */

    @media (max-width: 575px) {

        h1.text-center {

            font-size: 1.8rem;

        }


        .login-form-container {

            width: 94%;

        }


        .login-form-container
        .card-body {

            padding: 1rem;
        }


        .login-form-container
        .btn {

            width: 100%;

            display: block !important;

        }

    }

</style>


<div class="row">

    <h1 class="text-center text-light">
        User Login
    </h1>


    <div class="login-form-container mt-5">

        <form action="/signup" method="post">

            <div class="row">

                <div class="mb-3 col-md-6">

                    <label
                        class="form-label"
                        for="name"
                    >
                        Name
                    </label>

                    <input
                        class="form-control"
                        type="text"
                        required
                        id="name"
                        name="name"
                        placeholder="Enter your name"
                        minlength="3"
                        maxlength="30"
                    >

                </div>


                <div class="mb-3 col-md-6">

                    <label
                        class="form-label"
                        for="location"
                    >
                        Location
                    </label>

                    <input
                        class="form-control"
                        type="text"
                        required
                        id="location"
                        name="location"
                        placeholder="Enter your location"
                    >

                </div>

            </div>


            <div class="row">

                <div class="mb-3 col-md-6">

                    <label
                        class="form-label"
                        for="password"
                    >
                        Password
                    </label>

                    <input
                        class="form-control"
                        required
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                    >

                </div>


                <div class="mb-3 col-md-6">

                    <label
                        class="form-label"
                        for="age"
                    >
                        Age
                    </label>

                    <input
                        class="form-control"
                        type="number"
                        required
                        id="age"
                        name="age"
                        placeholder="Enter your age"
                        min="18"
                    >

                </div>

            </div>


            <div class="row">

                <div class="mb-3 col-md-9">

                    <label
                        class="form-label"
                        for="phoneNumber"
                    >
                        Phone Number
                    </label>

                    <input
                        class="form-control"
                        type="tel"
                        required
                        id="phoneNumber"
                        name="phoneNumber"
                        placeholder="Enter 10-digit phone number"
                        pattern="[0-9]{10}"
                        maxlength="10"
                        minlength="10"
                    >

                </div>


                <div class="mb-3">

                    <label
                        for="wardID"
                        class="form-label"
                    >
                        Ward
                    </label>


                    <select
                        class="form-select"
                        id="wardID"
                        name="wardID"
                        required
                    >

                        <option
                            value=""
                            selected
                            disabled
                        >
                            Select your ward
                        </option>


                        <% wards.forEach(ward=> { %>

                            <option
                                value="<%= ward.ward_id %>"
                            >
                                <%= ward.ward_name %>
                            </option>

                        <% }) %>

                    </select>

                </div>

            </div>


            <button
                type="submit"
                class="btn btn-outline-light d-inline m-2"
            >
                Add User
            </button>


            <a
                href="/"
                class="btn btn-outline-light btn-md mx-auto m-5"
            >
                Back to Home
            </a>

        </form>

    </div>

</div>